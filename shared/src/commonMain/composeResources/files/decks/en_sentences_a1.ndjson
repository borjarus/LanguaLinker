{"front": "The weather is nice today.", "back": "Dzisiaj jest ładna pogoda.", "tags": ["phrase", "A1"], "grammarTips": ["„weather” jest niepoliczalne — nie ma formy „weathers” ani „a weather”"], "wordLinks": [{"surfaceForm": "The", "wordCardRef": "the"}, {"surfaceForm": "weather", "wordCardRef": "weather"}, {"surfaceForm": "is", "wordCardRef": "to be"}, {"surfaceForm": "nice", "wordCardRef": "nice"}, {"surfaceForm": "today", "wordCardRef": "today"}]}
